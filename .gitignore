# ─── Dependencias ──────────────────────────────────────────────
node_modules/

# ─── Secretos ──────────────────────────────────────────────────
# Se ignora cualquier .env salvo la plantilla de ejemplo.
.env
.env.*
!.env.example

# Configuración de la app de escritorio: contiene el secreto de sesión,
# la contraseña del administrador y la clave de cifrado protegida.
# Vive en %APPDATA%/Contigo, pero no debe subirse nunca.
config.json
!frontend/**/config.json
!.claude/**/config.json

# ─── Datos de pacientes ────────────────────────────────────────
# El archivo del almacén guarda conversaciones sobre salud mental y
# fichas médicas. Normalmente vive en %APPDATA%, pero si alguien apunta
# CONTIGO_DATA_DIR a esta carpeta al hacer pruebas, no debe acabar en el
# repositorio: una vez en el historial de git, ya no se puede quitar.
contigo-data.json
contigo-data.json.*
*.sqlite
*.sqlite3
*.db

# Archivos que el almacén crea al lado del principal
*.lock
*.tmp
*.pre-sql-backup
*.backup-pre-sql-*

# ─── Compilados y empaquetados ─────────────────────────────────
frontend/dist/
release/
installers/

# ─── Sistema y editores ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ─── Registros ─────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

# ─── Herramientas ──────────────────────────────────────────────
.claude/
coverage/
.nyc_output/

# Skills instaladas en el entorno (no son parte del proyecto)
.agents/
