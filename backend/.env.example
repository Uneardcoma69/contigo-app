# Copia este archivo como .env y ajusta los valores.
# Solo JWT_SECRET es obligatorio.

PORT=3000
NODE_ENV=development

# Secreto con el que se firman los tokens de sesión (7 días de duración).
# OBLIGATORIO. Mínimo 32 caracteres; el servidor no arranca sin él.
# NO copies un valor de ejemplo: este archivo es público, y quien conozca
# el secreto puede fabricarse una sesión de administrador.
# Genera el tuyo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Asistente conversacional (opcional) ────────────────────────
# Sin ninguna clave, el chat funciona en modo demo con respuestas
# escritas a mano. El análisis de riesgo se ejecuta siempre.
# DeepSeek tiene prioridad si ambas están definidas.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ── Aviso de riesgo alto por correo (opcional) ─────────────────
# El panel de alertas se actualiza mientras alguien lo tiene abierto.
# Sin SMTP configurado, una alerta de riesgo ALTO solo se ve ahí; con
# esto, además se avisa por correo (con un margen de 30 min entre
# avisos a la misma persona, para no saturar en una crisis con varios
# mensajes seguidos).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente que verá quien reciba el correo. Vacío = se usa SMTP_USER.
SMTP_FROM=
# A quién avisar, además del psicólogo o monitor asignado a la
# persona (si tiene uno). Vacío = se usa ADMIN_EMAIL.
CONTIGO_ALERT_EMAIL=

# ── Administración ─────────────────────────────────────────────
# El usuario con este correo se trata como admin aunque su rol sea otro.
ADMIN_EMAIL=

# Con "true" crea las cuentas de prueba también fuera de desarrollo.
# Déjalo vacío en producción: son cuentas con contraseñas conocidas.
# Las cuentas de prueba solo se crean si NODE_ENV es exactamente
# "development" o si defines esta variable a propósito.
CONTIGO_SEED_DEMO=

# ── Despliegue ─────────────────────────────────────────────────
# Detrás de un proxy (Railway, Nginx): número de saltos hasta el
# cliente, normalmente 1. Sin esto el limitador de intentos mete a
# todos los usuarios en el mismo cupo.
TRUST_PROXY=

# Orígenes permitidos, separados por coma. Vacío = se refleja el
# origen de quien pide (necesario para la app de escritorio).
# Ejemplo: https://contigo.midominio.com
CONTIGO_ALLOWED_ORIGINS=

# ── Persistencia (las define sola la app de escritorio) ────────
# Sin CONTIGO_DATA_DIR los datos viven solo en memoria y se pierden
# al reiniciar el proceso.
CONTIGO_DATA_DIR=

# Clave de cifrado en hexadecimal, exactamente 32 bytes (64 caracteres).
# Sin ella el archivo de datos se guarda en claro.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTIGO_DATA_KEY=

# Contraseña de la cuenta de administrador (admin@contigo.com).
# La app de escritorio la genera al azar; en un servidor es la forma
# correcta de crear el primer acceso, porque fuera de desarrollo no se
# crea ninguna cuenta automáticamente. Usa una contraseña larga.
CONTIGO_ADMIN_PASSWORD=
