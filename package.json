{
  "name": "contigo-desktop",
  "productName": "Contigo",
  "version": "1.0.0",
  "description": "Contigo — Aquí Estoy. Centro de bienestar emocional y salud mental.",
  "author": "Contigo",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "electron .",
    "build:frontend": "npm --prefix frontend run build",
    "dist": "npm --prefix frontend run build && electron-builder --win",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.contigo.aquiestoy",
    "productName": "Contigo",
    "directories": {
      "output": "installers",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/**/*",
      "!desktop/build/**",
      "backend/**/*",
      "!backend/node_modules/**",
      "!backend/.env",
      "!backend/.env.example",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Contigo",
      "installerLanguages": ["es_ES"],
      "language": "3082"
    }
  }
}
